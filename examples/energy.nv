// Expectation values: the energy of a two-qubit Hamiltonian in a parameterised state.
//
//     noev run examples/energy.nv --shots 1
//
// The state is cos(θ/2)|00⟩ + sin(θ/2)|11⟩, so the energy is −1 + cos θ + ½ sin θ:
// 0 at θ = 0, −0.5 at θ = π/2, and −2 at θ = π. The simulator computes expectation values
// exactly, so one shot is enough.

fn ansatz(theta: Float) -> [Qubit; 2] {
    let r = |00>
    r[0].ry(theta)
    ctrl r[0] { r[1].x() }
    mv r
}

fn energy(theta: Float) -> Float {
    let h = -1.0 * Z(0) * Z(1) + 0.5 * (Z(0) + Z(1)) + 0.5 * X(0) * X(1)
    <ansatz(theta)| h |ansatz(theta)>
}

fn main() -> (Float, Float, Float) {
    (energy(0.0), energy(Float::PI / 2.0), energy(Float::PI))
}
