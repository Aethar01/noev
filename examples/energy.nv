// Expectation values: the energy of a two-qubit Hamiltonian in a parameterised state.
//
//     noev run examples/energy.nv
//
// The state is cos(θ/2)|00⟩ + sin(θ/2)|11⟩, so the energy is −1 + cos θ + ½ sin θ. The
// simulator computes expectation values exactly.

fn ansatz(theta: Float) -> [Qubit; 2] {
    let r = |00>
    r[0].ry(theta)
    ctrl r[0] { r[1].x() }
    mv r
}

fn energy(theta: Float) -> Float {
    let h = -1.0 * Z(0) * Z(1) + 0.5 * (Z(0) + Z(1)) + 0.5 * X(0) * X(1)
    <ansatz(theta)| h |ansatz(theta)>
}

fn main() {
    print("     θ     energy")
    for i in 0..9 {
        let theta = Float(i) * Float::PI / 8.0
        print("{theta:>6.3}  {energy(theta):>+9.4}")
    }
}
