// A Bell pair: two qubits that always measure the same.
//
//     noev run examples/bell.nv
//
// About half the runs give 11 and half 00, never 01 or 10.

fn bell_pair() -> (Bit, Bit) {
    let a = |+>
    let b = |0>
    ctrl a { b.x() }
    (mv a.measure(), mv b.measure())
}

fn main() {
    let d = sample 1000 { bell_pair() }
    print(d)
    print("P(11) = {d.probability((1, 1)):.3}, most likely: {d.most_likely()}")
}
