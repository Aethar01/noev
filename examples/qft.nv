// The quantum Fourier transform on 16 qubits, sampled.
//
//     noev run examples/qft.nv
//
// `main` returns its qubits instead of measuring them, which asks for sampling: the state is
// computed once and the simulator samples it for every shot (spec/core.md §6). On |0…0⟩ the
// QFT gives the uniform superposition, so every outcome is about equally likely.

fn qft(r: mut [Qubit; 16]) {
    for i in 0..16 {
        r[i].h()
        for j in i + 1..16 {
            ctrl r[j] { r[i].p(Float::PI / Float(1 << (j - i))) }
        }
    }
}

fn main() -> [Qubit; 16] {
    let r = |0000000000000000>
    qft(r)
    mv r
}
