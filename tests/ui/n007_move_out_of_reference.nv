// N007: moving out of a reference.

fn measure_lent(q: mut Qubit) -> Bit {
    mv q.measure()                  //~ N007
}

fn chain_ends_in_measure() -> Bit {
    let q = |0>
    q.h().measure()                 //~ N007
}

enum Held {
    Qubit(Qubit),
    Nothing,
}

fn move_out_of_a_lent_match(h: ref Held) -> Bit {
    match h {
        Held::Qubit(q) => mv q.measure(),       //~ N007
        Held::Nothing => 0,
    }
}

fn take_from_lent_option(o: ref Option<Qubit>) -> Bit {
    match o {
        Some(q) => mv q.measure(),          //~ N007
        None => 0,
    }
}
