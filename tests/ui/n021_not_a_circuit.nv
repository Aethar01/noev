// N021: a `circuit fn` that is not a circuit, or not a closed run.

circuit fn angle_from_measurement() -> Bit {
    let x = |+>
    let y = |0>
    let k = Int(mv x.measure())         //~ N021
    y.ry(Float(k))
    mv y.measure()
}

circuit fn passes_result() -> Bit {
    let x = |+>
    let b = mv x.measure()
    let y = |0>
    rotate_by(y, b)
    mv y.measure()
}

// Given a measurement result, this turns it into an angle.
fn rotate_by(q: mut Qubit, b: Bit) {
    q.ry(Float(Int(b)))                 //~ N021
}

circuit fn takes_a_qubit(q: mut Qubit) -> Bit { //~ N021
    q.h()
    let r = |0>
    mv r.measure()
}
