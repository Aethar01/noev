// N003: a linear value is still owned when its scope ends.

fn never_consumed() {
    let q = |+>
    q.h()
}                                   //~ N003

fn early_return(stop: Bool) {
    let q = |+>
    if stop {
        return                      //~ N003
    }
    mv q.discard()
}

fn discarded_final_value() {
    |+>                             //~ N003
}

fn wildcard() {
    let _ = |+>                     //~ N003
}

fn wildcard_in_patterns() {
    let pair = |01>
    let [a, _] = mv pair            //~ N003
    mv a.discard()
    let t = (|+>, 1)
    let (c, _) = mv t
    mv c.discard()
}

enum Held {
    Qubit(Qubit),
    Nothing,
}

fn enum_not_consumed() {
    let h = Held::Qubit(|+>)
}                                   //~ N003

fn arm_keeps_its_qubit(h: Held) -> Bit {
    match mv h {
        Held::Qubit(q) => 0,        //~ N003
        Held::Nothing => 0,
    }
}

fn wildcard_drops_the_qubit(h: Held) -> Bit {
    match mv h {
        Held::Qubit(_) => 0,        //~ N003
        Held::Nothing => 0,
    }
}

fn some_qubit_not_consumed() {
    let s = Some(|+>)
}                                   //~ N003

fn option_arm_keeps_its_qubit(o: Option<Qubit>) {
    match mv o {
        Some(q) => {}               //~ N003
        None => {}
    }
}

type Pair = [Qubit; 2]

fn alias_not_consumed() {
    let p: Pair = |01>
}                                   //~ N003

// A generic `T` with bounds written has exactly those, so without `Copy` it may be a qubit,
// and a value of it must be consumed too. (Without bounds written, dropping it would infer
// `T: Copy`.)
fn generic_dropped<T: Measure>(x: T) {
}                                   //~ N003
