// N003: a linear value is still owned when its scope ends.

fn never_consumed() {
    let q = |+>
    q.h()
}                                   //~ N003

fn early_return(stop: Bool) {
    let q = |0>
    if stop {
        return                      //~ N003
    }
    mv q.discard()
}

fn discarded_final_value() {
    |0>                             //~ N003
}

fn wildcard() {
    let _ = |0>                     //~ N003
}

fn wildcard_in_patterns() {
    let pair = |00>
    let [a, _] = mv pair            //~ N003
    mv a.discard()
    let t = (|0>, 1)
    let (c, _) = mv t
    mv c.discard()
}

enum Held {
    Qubit(Qubit),
    Nothing,
}

fn enum_not_consumed() {
    let h = Held::Qubit(|0>)
}                                   //~ N003

fn arm_keeps_its_qubit(h: Held) -> Bit {
    match mv h {
        Held::Qubit(q) => 0,        //~ N003
        Held::Nothing => 0,
    }
}

fn wildcard_drops_the_qubit(h: Held) -> Bit {
    match mv h {
        Held::Qubit(_) => 0,        //~ N003
        Held::Nothing => 0,
    }
}

fn some_qubit_not_consumed() {
    let s = Some(|0>)
}                                   //~ N003

fn option_arm_keeps_its_qubit(o: Option<Qubit>) {
    match mv o {
        Some(q) => {}               //~ N003
        None => {}
    }
}

type Pair = [Qubit; 2]

fn alias_not_consumed() {
    let p: Pair = |01>
}                                   //~ N003
