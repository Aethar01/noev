// Valid usage of `Vec<T>`, `String` methods, and `std::{io, env, fs, net}` (`spec/std.md`).

use std::env::{args, current_dir, var}
use std::fs::{create_dir_all, exists, read, read_to_string, remove_file, write, write_bytes}
use std::io::{stderr, stdin, stdout}
use std::net::{TcpListener, TcpStream}

fn main() {
    let mut v: Vec<Int> = Vec::new()
    v.push(1)
    v.push(2)
    v[0] = 10
    let _ = v.pop()
    let _ = v.get(0)
    let copy = v.clone()
    v.extend(copy)
    v.clear()

    let s = " hello,world "
    let parts = s.trim().split(",")
    let joined = String::join(parts, "-")
    let bytes = joined.as_bytes()
    let _ = String::from_utf8(bytes)

    let out = stdout().lock()
    let _ = out.write("hi\n")
    let _ = out.flush()
    let _ = stderr().flush()
    let _ = stdin()

    let _ = var("HOME")
    let _ = args()
    let _ = current_dir()

    let _ = exists("/tmp")
    let _ = create_dir_all("/tmp")
    let _ = write("/tmp/noev_pass_unused", "ok")
    let _ = read_to_string("/tmp/noev_pass_unused")
    let b = "ok".as_bytes()
    let _ = write_bytes("/tmp/noev_pass_unused", b)
    let _ = read("/tmp/noev_pass_unused")
    let _ = remove_file("/tmp/noev_pass_unused")

    let _ = TcpListener::bind("127.0.0.1:0")
    let _ = TcpStream::connect("127.0.0.1:1")
}
