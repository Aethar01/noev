// N009: a linear value is moved in some branches but not others.

fn if_without_else(flag: Bool) {
    let q = |+>
    if flag {                       //~ N009
        mv q.discard()
    }
}

fn right_side_of_and(flag: Bool) -> Bool {
    let q = |0>
    flag and <1| mv q               //~ N009
}

fn if_else_mismatch(flag: Bool) -> Bit {
    let q = |+>
    let b = |0>
    if flag {                       //~ N009
        mv q.discard()
    } else {
        b.x()
    }
    mv b.measure()
}

enum Basis { X, Y, Z }

fn moved_in_some_arms(b: Basis) {
    let q = |0>
    match b {                       //~ N009
        Basis::X => mv q.discard(),
        _ => {}
    }
}
