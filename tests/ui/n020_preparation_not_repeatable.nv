// N020: a run that is repeated (an expectation value's preparation, or a `sample` block)
// can only be given classical values.

fn prep(q: mut Qubit) -> Qubit {
    q.h()
    |+>
}

fn counted(n: mut Int) -> Qubit {
    n += 1
    |0>
}

fn outside_qubit() -> Float {
    let q = |0>
    let e = <prep(q)| Z(0) |prep(q)>        //~ N020
    mv q.discard()
    e
}

fn classical_mut_lend() -> Float {
    let mut n = 0
    <counted(mut n)| Z(0) |counted(mut n)>  //~ N020
}

fn sample_outside_qubit() {
    let q = |+>
    let d = sample 10 {
        q.h()                                   //~ N020
        5
    }
    mv q.discard()
    print(d)
}

fn sample_changes_outside() {
    let mut total = 0
    let d = sample 10 {
        total += 1                              //~ N020
        total
    }
    print(d, total)
}
