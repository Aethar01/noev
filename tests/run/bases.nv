// `measure_in`: each basis's eigenstates measure with certainty, 0 for the +1 eigenstate.

fn eigenstates(basis: Basis) -> (Bit, Bit) {
    let plus = |0>
    let minus = |1>
    // Rotate |0⟩ and |1⟩ onto the basis's eigenstates.
    match basis {
        Basis::X => {
            plus.h()
            minus.h()
        }
        Basis::Y => {
            plus.h().s()
            minus.h().s()
        }
        Basis::Z => {}
    }
    (mv plus.measure_in(basis), mv minus.measure_in(basis))
}

test fn measure_in_bases() {
    assert eigenstates(Basis::X) == (0, 1)
    assert eigenstates(Basis::Y) == (0, 1)
    assert eigenstates(Basis::Z) == (0, 1)
    let r = |+->
    assert mv r.measure_in(Basis::X) == [0, 1]
    let d = sample 200 { let q = |->; mv q.measure_in(Basis::X) }
    assert d.shots() == 200
    assert d.count(1) == 200
}
