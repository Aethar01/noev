// Operator traits (spec/types.md §6): `+`, `*`, `/`, `%` and `-` on types of the program's
// own, chosen by the right side's type, through a bound on a generic function, and on qubits,
// where the operands are moved with `mv`; and the compound assignments, which change a value
// in place, reversibly when the `impl` is.

use std::cmp::{Eq, Ord}
use std::ops::{
    Add, AddAssign, BitAnd, BitAndAssign, BitNot, BitOr, BitXor, Div, Mul, MulAssign, Neg, Rem,
    RemAssign, Shl, ShlAssign, Shr, SubAssign,
}

struct V { x: Int, y: Int }

impl Add for V {
    type Output = V
    fn add(mv self, rhs: V) -> V { V { x: self.x + rhs.x, y: self.y + rhs.y } }
}

impl Mul<Int> for V {
    type Output = V
    fn mul(mv self, k: Int) -> V { V { x: self.x * k, y: self.y * k } }
}

// The dot product: another `impl` of `Mul`, picked by the right side's type.
impl Mul<V> for V {
    type Output = Int
    fn mul(mv self, rhs: V) -> Int { self.x * rhs.x + self.y * rhs.y }
}

impl Neg for V {
    type Output = V
    fn neg(mv self) -> V { V { x: -self.x, y: -self.y } }
}

impl Div<Int> for V {
    type Output = V
    fn div(mv self, k: Int) -> V { V { x: self.x / k, y: self.y / k } }
}

impl Rem<Int> for V {
    type Output = V
    fn rem(mv self, k: Int) -> V { V { x: self.x % k, y: self.y % k } }
}

impl AddAssign<V> for V {
    fn add_assign(mut self, rhs: V) {
        self.x += rhs.x
        self.y += rhs.y
    }
}

impl SubAssign<V> for V {
    fn sub_assign(mut self, rhs: V) {
        self.x -= rhs.x
        self.y -= rhs.y
    }
}

impl MulAssign<Int> for V {
    fn mul_assign(mut self, k: Int) {
        self.x *= k
        self.y *= k
    }
}

impl RemAssign<Int> for V {
    fn rem_assign(mut self, k: Int) {
        self.x %= k
        self.y %= k
    }
}

fn sum3<T: Add<Output = T>>(a: T, b: T, c: T) -> T { mv a + mv b + mv c }

struct Bits { v: Int }

impl BitAnd for Bits {
    type Output = Bits
    fn bitand(mv self, rhs: Bits) -> Bits { Bits { v: self.v & rhs.v } }
}
impl BitOr for Bits {
    type Output = Bits
    fn bitor(mv self, rhs: Bits) -> Bits { Bits { v: self.v | rhs.v } }
}
impl BitXor for Bits {
    type Output = Bits
    fn bitxor(mv self, rhs: Bits) -> Bits { Bits { v: self.v ^ rhs.v } }
}
impl BitNot for Bits {
    type Output = Bits
    fn bitnot(mv self) -> Bits { Bits { v: ~self.v } }
}
impl Shl<Int> for Bits {
    type Output = Bits
    fn shl(mv self, n: Int) -> Bits { Bits { v: self.v << n } }
}
impl Shr<Int> for Bits {
    type Output = Bits
    fn shr(mv self, n: Int) -> Bits { Bits { v: self.v >> n } }
}
impl BitAndAssign for Bits {
    fn bitand_assign(mut self, rhs: Bits) { self.v &= rhs.v }
}
impl ShlAssign<Int> for Bits {
    fn shl_assign(mut self, n: Int) { self.v <<= n }
}
impl Eq for Bits {
    fn eq(ref self, rhs: ref Bits) -> Bool { self.v == rhs.v }
}
impl Ord for Bits {
    fn lt(ref self, rhs: ref Bits) -> Bool { self.v < rhs.v }
    fn le(ref self, rhs: ref Bits) -> Bool { self.v <= rhs.v }
}

fn clamp_order<T: Eq + Ord>(a: ref T, b: ref T) -> (Bool, Bool, Bool, Bool, Bool, Bool) {
    (a == b, a != b, a < b, a <= b, a > b, a >= b)
}

// Two qubits; adding one register to another XORs it in, and negating flips both.
struct Reg { qs: [Qubit; 2] }

impl Add<Reg> for Reg {
    type Output = Reg
    fn add(mv self, rhs: Reg) -> Reg {
        let a = mv self.qs
        let b = mv rhs.qs
        for i in 0..2 { ctrl b[i] { a[i].x() } }
        mv b.measure()
        Reg { qs: mv a }
    }
}

// In place: XORs another register in, so it undoes itself, and `adj` can run it.
impl AddAssign<ref Reg> for Reg {
    fn add_assign(mut self, rhs: ref Reg) {
        for i in 0..2 { ctrl rhs.qs[i] { self.qs[i].x() } }
    }
}

rev fn xor_in(a: mut Reg, b: ref Reg) { a += b }

impl Neg for Reg {
    type Output = Reg
    fn neg(mv self) -> Reg {
        let a = mv self.qs
        a[0].x()
        a[1].x()
        Reg { qs: mv a }
    }
}

test fn operator_traits() {
    let a = V { x: 1, y: 2 }
    let b = V { x: 10, y: 20 }
    let c = -(a + b * 2)
    assert (c.x, c.y) == (-21, -42)
    assert a * b == 50
    let d = sum3(a, b, c)
    assert (d.x, d.y) == (-10, -20)
    assert 1 + 2 * 3 == 7
    let e = b / 3 % 4
    assert (e.x, e.y) == (3, 2)
    let mut m = V { x: 3, y: 4 }
    m += a
    m -= V { x: 1, y: 1 }
    m *= 10
    m %= 7
    assert (m.x, m.y) == (2, 1)
    let r = Reg { qs: |10> }
    let s = Reg { qs: |11> }
    let t = -(mv r + mv s)
    assert mv t.qs.measure() == [1, 0]
    let p = Reg { qs: |10> }
    let q = Reg { qs: |11> }
    p += q
    xor_in(mut p, ref q)
    adj xor_in(mut p, ref q)
    assert mv p.qs.measure() == [0, 1]
    mv q.qs.measure()
    let x = Bits { v: 0b1100 }
    let y = Bits { v: 0b1010 }
    let z = ((x & y) | (x ^ y)) << 1
    let mut w = z >> 1
    w &= Bits { v: 0b0111 }
    w <<= 2
    let inv = ~Bits { v: 0 }
    assert (w.v, inv.v) == (24, -1)
    assert clamp_order(ref x, ref y) == (false, true, false, false, true, true)
    assert x == x and x != y and x > y and x >= x
}
