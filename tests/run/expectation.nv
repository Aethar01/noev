// Expectation values of eigenstates, which are exact even when estimated.

fn ones() -> [Qubit; 2] {
    let r = |11>
    mv r
}

test fn expectation_values() {
    assert "{<0| Z(0) |0>:.6}" == "1.000000"
    assert "{<1| Z(0) |1>:.6}" == "-1.000000"
    assert "{<+| X(0) |+>:.6}" == "1.000000"
    assert "{<ones()| 0.5 * Z(0) * Z(1) - 2.0 * Z(1) + 0.25 * I() |ones()> within 0.1:.6}" == "2.750000"
}
