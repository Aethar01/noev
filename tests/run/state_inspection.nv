// `amplitudes(r)` (spec/std.md §2): a register's state on a simulator, for debugging. It
// lends the register, and fixes the overall phase so the first amplitude that is not zero is
// real and positive.

use std::debug::amplitudes

test fn state_inspection() {
    let r = |+0>
    ctrl r[0] { r[1].x() }
    let bell = amplitudes(r)
    assert bell[1] == 0.0 + 0.0i
    assert bell[2] == 0.0 + 0.0i
    assert (bell[0] - bell[3]).abs() < 1e-12
    let q = |(+i)>
    let one = |1>
    assert "{amplitudes(one)}" == "[0.0+0.0i, 1.0+0.0i]"
    assert (amplitudes(q)[1] - amplitudes(q)[0] * 1i).abs() < 1e-12
    // Lent, not consumed: the qubits are still there to measure.
    let m = mv r.measure()
    assert m[0] == m[1]
    assert <(+i)| mv q
    assert <1| mv one
}
