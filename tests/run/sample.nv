// `sample` blocks with certain outcomes, a circuit with feedback through a helper, and
// values read from around the block.

fn correct(q: mut Qubit, flip: Bit) {
    if flip == 1 { q.x() }
}

// Whatever `a` measures, `b` ends up in |1>.
fn always_one() -> Bit {
    let a = |+>
    let b = |0>
    ctrl a { b.x() }
    let m = mv a.measure()
    correct(b, m)
    b.x()
    mv b.measure()
}

test fn sample_distributions() {
    let d = sample 1000 { always_one() }
    assert "{d}" == "1  1000  100.0%"
    assert d.shots() == 1000
    assert d.count(1) == 1000
    assert d.probability(0) == 0.0
    assert d.most_likely() == 1
    let flip = true
    let n = 3
    let e = sample 50 {
        let q = |0>
        if flip { q.x() }
        (mv q.measure(), n)
    }
    assert "{e}" == "(1, 3)  50  100.0%"
    let r = sample 20 {
        let pair = |00>
        pair[1].x()
        mv pair
    }
    assert "{r}" == "01  20  100.0%"
}
