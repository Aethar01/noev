// Amplitudes and transition values (spec/types.md §3): ⟨φ|ψ⟩ and ⟨φ|H|ψ⟩ as `Complex`
// numbers, exact on a simulator.

fn bell() -> [Qubit; 2] {
    let r = |+0>
    ctrl r[0] { r[1].x() }
    mv r
}

fn phased() -> Qubit {
    let q = |+>
    q.s()
    mv q
}

test fn overlaps_and_phases() {
    assert <+|-> == 0.0 + 0.0i
    assert <0|1> == 0.0 + 0.0i
    assert (<bell()|bell()> - 1.0).abs() < 1e-12
    assert <bell()|11> == <bell()|00>
    assert (<phased()|(+i)> - 1.0).abs() < 1e-12
    assert <+|phased()>.arg() == Float::PI / 4.0
}

test fn transition_values() {
    // ⟨0|X|1⟩ = 1, ⟨0|Z|1⟩ = 0, ⟨0|Y|1⟩ = −i.
    assert "{<0| X(0) |1>}" == "1.0+0.0i"
    assert "{<0| Z(0) |1>}" == "0.0+0.0i"
    assert "{<0| Y(0) |1>}" == "0.0-1.0i"
    // With the same preparation on both sides, an expectation value.
    assert <bell()| Z(0) * Z(1) |bell()>.round() == 1
}
