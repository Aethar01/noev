// Amplitudes and transition values (spec/types.md §3): ⟨φ|ψ⟩ and ⟨φ|H|ψ⟩ as `Complex`
// numbers, exact on a simulator.

fn bell() -> [Qubit; 2] {
    let r = |+0>
    ctrl r[0] { r[1].x() }
    mv r
}

fn phased() -> Qubit {
    let q = |+>
    q.s()
    mv q
}

fn main() {
    print(<+|->, <0|1>, (<bell()|bell()> - 1.0).abs() < 1e-12, <bell()|11> == <bell()|00>)
    print((<phased()|(+i)> - 1.0).abs() < 1e-12, <+|phased()>.arg() == Float::PI / 4.0)
    // ⟨0|X|1⟩ = 1, ⟨0|Z|1⟩ = 0, ⟨0|Y|1⟩ = −i.
    print(<0| X(0) |1>, <0| Z(0) |1>, <0| Y(0) |1>)
    // With the same preparation on both sides, an expectation value.
    print(<bell()| Z(0) * Z(1) |bell()>.round())
}
