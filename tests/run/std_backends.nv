// End-to-end test of Step 16 (`spec/std.md` §5–§6):
// `Vec<T>`, `String` methods, `std::io`, `std::env`, `std::fs`, and `std::net`.

use std::env::{args, current_dir, var}
use std::fs::{create_dir_all, exists, read, read_to_string, remove_file, write, write_bytes}
use std::io::stdout
use std::net::{TcpListener, TcpStream}

test fn vec_operations() {
    let mut v: Vec<Int> = Vec::new()
    assert v.len() == 0 and v.is_empty()
    v.push(10)
    v.push(20)
    v.push(30)
    assert v.len() == 3 and not v.is_empty()
    assert v[0] == 10 and v[1] == 20 and v[2] == 30
    v[1] = 25
    v[2] += 5
    assert "{v}" == "[10, 25, 35]"
    let popped = v.pop()
    assert popped == Some(35)
    assert v.get(1) == Some(25)
    assert v.get(99) == None
    let mut w = Vec::<Int>::with_capacity(4)
    w.push(10)
    w.push(25)
    assert v == w
    let cloned = v.clone()
    v.extend(cloned)
    assert "{v}" == "[10, 25, 10, 25]"
    v.clear()
    assert v.len() == 0 and v.is_empty()
}

test fn string_operations() {
    let raw = "  alpha, beta, gamma  "
    let t = raw.trim()
    assert t.len() == 18 and not t.is_empty()
    assert t.contains("beta") and t.starts_with("alpha") and t.ends_with("gamma")
    let parts = t.split(", ")
    assert parts.len() == 3 and parts[0] == "alpha" and parts[2] == "gamma"
    assert String::join(parts, "|") == "alpha|beta|gamma"
    let lines = "one\ntwo\nthree".lines()
    assert lines.len() == 3 and lines[1] == "two"
    assert "foo bar foo".replace("foo", "baz") == "baz bar baz"
    assert "abcdef".substring(1, 4) == Some("bcd")
    assert "abcdef".find("cd") == Some(2)
    assert "abcdef".find("zz") == None
    assert "NoEv".to_uppercase() == "NOEV"
    assert "NoEv".to_lowercase() == "noev"
    assert "ab".repeat(3) == "ababab"
    let mut s = "hel" + "lo"
    s += "!"
    assert s == "hello!"
    let bytes = "ok".as_bytes()
    assert bytes.len() == 2 and bytes[0] == 111 and bytes[1] == 107
    assert "{String::from_utf8(bytes)}" == "Ok(ok)"
    assert "42".parse_int() == Ok(42)
    assert "3.5".parse_float() == Ok(3.5)
    let bad = match "bad".parse_int() {
        Ok(_) => false,
        Err(_) => true,
    }
    assert bad
}

test fn io_env_fs_net() {
    // std::io
    let out = stdout().lock()
    let _ = out.write("io-line\n")
    let _ = out.flush()

    // std::env
    let a = args()
    let cwd_ok = match current_dir() {
        Ok(d) => not d.is_empty()
        Err(_) => false
    }
    let missing = var("NOEV_DEFINITELY_UNSET_VAR_12345")
    assert a.len() >= 1 and cwd_ok and missing == None

    // std::fs + std::net loopback echo on ephemeral port
    let listener = match TcpListener::bind("127.0.0.1:0") {
        Ok(l) => mv l
        Err(e) => {
            assert false, "bind failed: {e}"
            return
        }
    }
    let addr = match listener.local_addr() {
        Ok(s) => s
        Err(e) => {
            assert false, "addr failed: {e}"
            return
        }
    }
    let port = match addr.split(":").get(1) {
        Some(p) => p
        None => "0"
    }
    let dir = "/tmp/noev_std_test_" + port
    let path = dir + "/hello.txt"
    let bpath = dir + "/bytes.bin"
    let _ = create_dir_all(dir)
    let _ = write(path, "hello backend\nline 2")
    let text = match read_to_string(path) {
        Ok(t) => t
        Err(e) => e
    }
    let bdata = "ABC".as_bytes()
    let _ = write_bytes(bpath, bdata)
    let rbytes = match read(bpath) {
        Ok(b) => mv b
        Err(_) => Vec::<u8>::new()
    }
    let existed_before = exists(path)
    let _ = remove_file(path)
    let _ = remove_file(bpath)
    let existed_after = exists(path)
    assert existed_before and not existed_after
    assert text.lines().len() == 2
    assert "{String::from_utf8(rbytes)}" == "Ok(ABC)"

    let client = match TcpStream::connect(addr) {
        Ok(c) => mv c
        Err(e) => {
            assert false, "connect failed: {e}"
            return
        }
    }
    let server = match listener.accept() {
        Ok(s) => mv s
        Err(e) => {
            assert false, "accept failed: {e}"
            return
        }
    }
    let n_sent = match client.write_str("ping-noev") {
        Ok(n) => n
        Err(_) => -1
    }
    let _ = client.flush()
    let _ = client.shutdown()
    let received = match server.read_to_string() {
        Ok(msg) => msg
        Err(e) => e
    }
    mv client.close()
    mv server.close()
    mv listener.close()
    assert n_sent == 9
    assert received == "ping-noev"
}
