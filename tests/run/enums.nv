// Enums and `match`: variants, methods, equality and printing.

enum Basis {
    X
    Y
    Z

    fn next(ref self) -> Self {
        match self {
            Basis::X => Basis::Y,
            Basis::Y => Basis::Z,
            Basis::Z => Basis::X,
        }
    }
}

fn describe(n: Int) -> String {
    match n {
        0 => "none",
        1 => "one",
        -1 => "minus one",
        _ => "many",
    }
}

test fn enums_and_match() {
    let b = Basis::Y
    assert "{b}" == "Basis::Y"
    assert b.next() == Basis::Z
    assert b.next().next() == Basis::X
    assert b == Basis::Y
    assert not (b != Basis::Y)
    assert describe(0) == "none"
    assert describe(1) == "one"
    assert describe(-1) == "minus one"
    assert describe(7) == "many"
    let q = |1>
    let word = match mv q.measure() {
        0 => "zero",
        1 => "one",
    }
    assert "measured {word}, then {b.next()}" == "measured one, then Basis::Z"
}
