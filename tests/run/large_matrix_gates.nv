// Larger matrix gates (`spec/core.md` §1): 3- and 4-qubit unitaries decomposed via QSD,
// with `adj`, `ctrl` (preserving exact global phase), and circuit `sample`.

fn make_ccx() -> [[Complex; 8]; 8] {
    let mut m = [[0.0 + 0i; 8]; 8]
    for i in 0..8 {
        m[i][i] = 1.0 + 0i
    }
    m[6][6] = 0.0 + 0i
    m[7][7] = 0.0 + 0i
    m[6][7] = 1.0 + 0i
    m[7][6] = 1.0 + 0i
    m
}

fn make_cswap() -> [[Complex; 8]; 8] {
    let mut m = [[0.0 + 0i; 8]; 8]
    for i in 0..8 {
        m[i][i] = 1.0 + 0i
    }
    m[5][5] = 0.0 + 0i
    m[6][6] = 0.0 + 0i
    m[5][6] = 1.0 + 0i
    m[6][5] = 1.0 + 0i
    m
}

fn make_qft3() -> [[Complex; 8]; 8] {
    let mut m = [[0.0 + 0i; 8]; 8]
    let inv = 1.0 / Float(8).sqrt()
    for i in 0..8 {
        for j in 0..8 {
            let angle = Float::TAU * Float(i * j) / 8.0
            m[i][j] = Complex::polar(inv, angle)
        }
    }
    m
}

fn make_i_ccx() -> [[Complex; 8]; 8] {
    let base = make_ccx()
    let mut m = [[0.0 + 0i; 8]; 8]
    for i in 0..8 {
        for j in 0..8 {
            m[i][j] = base[i][j] * 1i
        }
    }
    m
}

fn make_cccx() -> [[Complex; 16]; 16] {
    let mut m = [[0.0 + 0i; 16]; 16]
    for i in 0..16 {
        m[i][i] = 1.0 + 0i
    }
    m[14][14] = 0.0 + 0i
    m[15][15] = 0.0 + 0i
    m[14][15] = 1.0 + 0i
    m[15][14] = 1.0 + 0i
    m
}

fn main() {
    let ccx = make_ccx()
    let cswap = make_cswap()
    let qft3 = make_qft3()
    let i_ccx = make_i_ccx()
    let cccx = make_cccx()

    // 1. 3-qubit Toffoli: |110> -> |111>, |100> -> |100>.
    let a = |110>
    a.unitary(ccx)
    print(mv a.measure())
    let b = |100>
    b.unitary(ccx)
    print(mv b.measure())

    // 2. 3-qubit Fredkin (CSWAP): |101> -> |110>.
    let c = |101>
    c.unitary(cswap)
    print(mv c.measure())

    // 3. 3-qubit QFT followed by its adjoint restores |101>.
    let d = |101>
    d.unitary(qft3)
    adj d.unitary(qft3)
    print(mv d.measure())

    // 4. Controlled 3-qubit matrix with global phase i inside `sample`:
    //    control |+> picks up relative phase i -> |+i>, while |110> -> |111> on the |1> branch.
    print(sample 50 {
        let ctrl_q = |+>
        let reg = |110>
        ctrl ctrl_q { reg.unitary(i_ccx) }
        ctrl ctrl_q { reg.unitary(ccx) }
        (<(+i)| mv ctrl_q, mv reg.measure())
    })

    // 5. 4-qubit CCCX: |1110> -> |1111>, |1100> -> |1100>.
    let e = |1110>
    e.unitary(cccx)
    print(mv e.measure())
    let f = |1100>
    f.unitary(cccx)
    print(mv f.measure())
}
