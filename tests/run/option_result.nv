/// The first even number, if there is one.
fn first_even(xs: [Int; 4]) -> Option<Int> {
    for i in 0..4 {
        let x = xs[i]
        if x % 2 == 0 { return Some(x) }
    }
    None
}

fn divide(a: Int, b: Int) -> Result<Int, String> {
    if b == 0 { Err("division by zero") } else { Ok(a / b) }
}

fn use_spare(spare: Option<Qubit>) -> Bit {
    match mv spare {
        Some(q) => mv q.measure(),
        None => 0,
    }
}

fn spare_is_set(spare: ref Option<Qubit>) -> Bool {
    match spare {
        Some(_) => true,
        None => false,
    }
}

test fn option_and_result() {
    assert "{first_even([1, 3, 4, 5])} {first_even([1, 3, 5, 7])}" == "Some(4) None"
    assert "{divide(7, 2)} {divide(1, 0)}" == "Ok(3) Err(division by zero)"
    let msg = match divide(9, 3) {
        Ok(n) => "got {n}",
        Err(e) => "failed: {e}",
    }
    assert msg == "got 3"
    let s = Some(|1>)
    assert spare_is_set(s)
    assert use_spare(mv s) == 1
    let n: Option<Bit> = None
    assert n == None
    assert Some(1) == Some(1)
    assert Some(2) != Some(3)
    let pair: (Option<Float>, Result<Bool, Int>) = (Some(1.5), Ok(true))
    assert "{pair}" == "(Some(1.5), Ok(true))"
}
