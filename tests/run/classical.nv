// Classical code: loops, mutation through lends, conversions and arithmetic.

fn steps(start: Int) -> Int {
    let mut n = start
    let mut k = 0
    while n != 1 {
        if n % 2 == 0 { n /= 2 } else { n = 3 * n + 1 }
        k += 1
    }
    k
}

fn bump(n: mut Int) {
    n += 1
}

fn main() {
    print(steps(27))
    let mut n = 1
    bump(mut n)
    bump(mut n)
    print(n)
    print((2.7).round() + Int(Bool(Bit(true))))
    let mut total = 0
    for i in 0..10 {
        total += i * i
    }
    print(total, 7 / 2, 7 % 2, -7 / 2, 2.0 * 3.5)
}
