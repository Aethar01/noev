// Classical code: loops, mutation through lends, conversions and arithmetic.

fn steps(start: Int) -> Int {
    let mut n = start
    let mut k = 0
    while n != 1 {
        if n % 2 == 0 { n /= 2 } else { n = 3 * n + 1 }
        k += 1
    }
    k
}

fn bump(n: mut Int) {
    n += 1
}

test fn classical_control_and_math() {
    assert steps(27) == 111
    let mut n = 1
    bump(mut n)
    bump(mut n)
    assert n == 3
    assert (2.7).round() + Int(Bool(Bit(true))) == 4
    let mut total = 0
    for i in 0..10 {
        total += i * i
    }
    assert total == 285
    assert 7 / 2 == 3
    assert 7 % 2 == 1
    assert -7 / 2 == -3
    assert 2.0 * 3.5 == 7.0
}
