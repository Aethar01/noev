// `Measure` as a trait (spec/types.md §6): a struct of ours measures to a classical struct
// by an `impl`, and generic code measures anything that implements it, qubits included.

struct Experiment {
    angle: Float
    state: Qubit
}

struct ExperimentResult {
    angle: Float
    outcome: Bit
}

impl Measure for Experiment {
    type Result = ExperimentResult
    fn measure(mv self) -> ExperimentResult {
        ExperimentResult { angle: self.angle, outcome: mv self.state.measure() }
    }
}

fn read<T: Measure>(x: T) -> T::Result { mv x.measure() }

test fn measure_trait() {
    let e = Experiment { angle: 0.5, state: |1> }
    let r = read(mv e)
    assert r.angle == 0.5 and r.outcome == 1
    assert read(|1>) == 1
    assert read(|10>) == [1, 0]
    let f = Experiment { angle: 1.5, state: |0> }
    let s = measure(mv f)
    assert s.angle == 1.5 and s.outcome == 0
    let g = Experiment { angle: 2.5, state: |1> }
    let t = mv g.measure()
    assert t.outcome == 1
}
