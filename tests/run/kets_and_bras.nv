// Kets read left to right; bras measure in their own basis.

test fn kets_and_bras() {
    let r = |101>
    assert mv r.measure() == [1, 0, 1]
    let plus = |+>
    let minus = |->
    assert <+| mv plus
    assert not (<+| mv minus)
    let pair = |1+>
    assert <1+| mv pair
    // A label in parentheses is one qubit: the Y basis's |+i⟩ and |−i⟩.
    let y = |(+i)(-i)>
    assert <(+i)(-i)| mv y
    let turned = |(+i)>
    turned.s()
    assert <-| mv turned
}
