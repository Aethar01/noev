// `Int` has any size (spec/types.md §1): it never overflows, and small values stay small.

fn factorial(n: Int) -> Int {
    let mut r = 1
    for i in 1..n + 1 {
        r *= i
    }
    r
}

test fn big_int_arithmetic() {
    let mut n = 9223372036854775807
    n += 1
    assert "{n}" == "9223372036854775808"
    assert "{-n - 1}" == "-9223372036854775809"
    assert n - 1 == 9223372036854775807
    assert "{factorial(30)}" == "265252859812191058636308480000000"
    assert factorial(30) / factorial(28) == 870
    assert 123456789012345678901234567890 % 1000 == 890
    assert "{0xffff_ffff_ffff_ffff_ff}" == "4722366482869645213695"
    // Endless two's complement, and `>>` rounding down.
    assert "{1 << 100}" == "1267650600228229401496703205376"
    assert (1 << 100) >> 99 == 2
    assert "{~(1 << 70)}" == "-1180591620717411303425"
    assert -(1 << 70) >> 69 == -2
    assert "{factorial(25):x} {factorial(22):+}" == "cd4a0619fb0907bc00000 +1124000727777607680000"
    // Division truncates toward zero; the remainder has the dividend's sign.
    assert -7 / 2 == -3
    assert -7 % 2 == -1
    assert "{-(1 << 80) / 3}" == "-402975273204876391568725"
    assert -(1 << 80) % 3 == -1
    assert "{Float(1 << 80)}" == "1.2089258196146292e24"
    assert "{(2.5e20).trunc()}" == "250000000000000000000"
    let a = [10, 20, 30]
    assert a[n - 9223372036854775807] == 20
}
