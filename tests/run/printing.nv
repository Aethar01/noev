// Formatting each type and interpolation with format specs.

struct P {
    x: Int
    y: Float
}

test fn formatting_and_interpolation() {
    let r = |01>
    let bits = mv r.measure()
    let line = "bits: {bits} {3} {-1.0} {true} {(1, 2.5)} {[4, 5]} {P { x: 1, y: 2.0 }}"
    assert line == "bits: 01 3 -1.0 true (1, 2.5) [4, 5] P {{ x: 1, y: 2.0 }"
    let n = 5
    let f = 0.126
    let formatted = "n={n:>3} f={f:.2} b={n:08b} hex={255:x} {{literal} {Float::PI:+.3}"
    assert formatted == "n=  5 f=0.13 b=00000101 hex=ff {{literal} +3.142"
}
