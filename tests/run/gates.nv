// Gates, `adj`, `ctrl` with several controls, and a reversible function undone.

fn majority(a: mut Qubit, b: mut Qubit, c: mut Qubit) {
    ctrl c { b.x(); a.x() }
    ctrl a, b { c.x() }
}

fn rot(q: mut Qubit) {
    q.ry(0.7)
    q.rz(0.3)
    q.h()
}

test fn toffoli_and_fredkin() {
    for a in 0..2 {
        for b in 0..2 {
            let x = |0>
            let y = |0>
            let t = |0>
            if a == 1 { x.x() }
            if b == 1 { y.x() }
            ctrl x, y { t.x() }
            assert Int(mv x.measure()) == a
            assert Int(mv y.measure()) == b
            assert Int(mv t.measure()) == (if a == 1 and b == 1 { 1 } else { 0 })
        }
    }
    let f = |110>
    ctrl f[0] { swap(f[1], f[2]) }
    assert mv f.measure() == [1, 0, 1]
}

test fn adj_undoes() {
    let q = |+>
    q.t()
    adj q.t()
    q.h()
    assert mv q.measure() == 0
    let p = |0>
    rot(p)
    adj rot(p)
    assert mv p.measure() == 0
    let m = |110>
    majority(m[0], m[1], m[2])
    adj majority(m[0], m[1], m[2])
    assert mv m.measure() == [1, 1, 0]
}
