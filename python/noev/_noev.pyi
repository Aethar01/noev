from collections.abc import Callable
from typing import Any

__version__: str

class NoevError(Exception): ...
class CompileError(NoevError): ...
class ValidationError(NoevError): ...
class RuntimeError(NoevError): ...

class Observable:
    def __init__(
        self, terms: list[tuple[float, list[tuple[int, str]]]] | None = None
    ) -> None: ...
    @staticmethod
    def x(qubit: int) -> Observable: ...
    @staticmethod
    def y(qubit: int) -> Observable: ...
    @staticmethod
    def z(qubit: int) -> Observable: ...
    @staticmethod
    def identity(coeff: float = 1.0) -> Observable: ...
    @property
    def terms(self) -> list[tuple[float, list[tuple[int, str]]]]: ...
    def __add__(self, other: Observable) -> Observable: ...
    def __sub__(self, other: Observable) -> Observable: ...
    def __neg__(self) -> Observable: ...
    def __mul__(self, other: float | Observable) -> Observable: ...
    def __rmul__(self, scale: float) -> Observable: ...

class Struct:
    type_name: str
    def __init__(self, type_name: str, **kwargs: Any) -> None: ...
    def to_dict(self) -> dict[str, Any]: ...
    def __getattr__(self, name: str) -> Any: ...
    def __getitem__(self, name: str) -> Any: ...

class Enum:
    type_name: str
    variant: str
    def __init__(self, type_name: str, variant: str, *fields: Any) -> None: ...
    @property
    def fields(self) -> tuple[Any, ...]: ...
    @property
    def value(self) -> Any: ...

class Distribution:
    shots: int
    def outcomes(self) -> list[tuple[Any, int]]: ...
    def count(self, target: Any) -> int: ...
    def probability(self, target: Any) -> float: ...

class Program:
    @staticmethod
    def compile_file(path: str) -> Program: ...
    @staticmethod
    def compile_source(source: str) -> Program: ...
    @property
    def extern_fns(self) -> list[str]: ...
    @property
    def functions(self) -> list[str]: ...
    def has_function(self, name: str) -> bool: ...

class HostContext:
    def call(self, name: str, *args: Any) -> Any: ...

class Runtime:
    def __init__(
        self,
        program: Program,
        *,
        seed: int = 0,
        backend: str | None = None,
    ) -> None: ...
    def seed(self, seed: int) -> Runtime: ...
    def capture_output(self, enabled: bool) -> Runtime: ...
    @property
    def last_stdout(self) -> str: ...
    @property
    def last_stderr(self) -> str: ...
    def host_fn(self, name: str, func: Callable[..., Any]) -> Runtime: ...
    def host_fn_with_context(
        self, name: str, func: Callable[..., Any]
    ) -> Runtime: ...
    def validate(self) -> None: ...
    def call(self, name: str, *args: Any) -> Any: ...
